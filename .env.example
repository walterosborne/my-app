# Copy this file to one of the runtime env files below and fill in real values:
# - .env.local for local development
# - .env.production.local on the IIS server
#
# mssqlserver.js reads these SQL Server host/database values and uses the
# Windows service identity / gMSA for authentication.
# server.js also loads these files for local PostgreSQL testing.

auditserver=
auditdb=
server=
database=

# Optional but recommended for links generated in backend emails.
APP_BASE_URL=

# Local server.js PostgreSQL settings.
PGHOST=localhost
PGDATABASE=audit_db
PGUSER=
PGPASSWORD=
PGPORT=5432

# Optional. mssqlserver.js defaults to production and server.js defaults to development.
NODE_ENV=
