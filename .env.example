# Copy this file to one of the runtime env files below and fill in real values:
# - .env.local for local development
# - .env.production.local for local production-mode testing
#
# mssqlserver.js reads these values for the production SQL Server connections.
# server.js also loads these files for local PostgreSQL testing.

auditserver=
auditdb=
audituser=
auditpassword=
server=
database=
user=
password=

# Optional but recommended for links generated in backend emails.
APP_BASE_URL=

# Local server.js PostgreSQL settings.
PGHOST=localhost
PGDATABASE=audit_db
PGUSER=
PGPASSWORD=
PGPORT=5432

# NGAT_ENV controls the audit SQL schema independently of NODE_ENV and hostname.
# dev -> dev; prod -> dbo; legacy stg -> stag.
# REQUIRED when NODE_ENV=production (including in OpenShift dev).
NGAT_ENV=dev
# NODE_ENV=production is still used to serve the built React app.
NODE_ENV=

# OPTIONAL, LOCAL ONLY: when Entra/Graph fails, look up this ID in roster_r.myid.
# Requires NODE_ENV != production AND NGAT_ENV=dev. Never set in OpenShift.
# Put a real ID in ignored .env.local, NOT in this tracked example.
NGAT_DEV_EMPLOYEE_ID=
