# Copy this file to one of the runtime env files below and fill in real values:
# - .env.local for local development
# - .env.production.local on the IIS server
#
# mssqlserver.js reads these values for the production SQL Server connections.
# server.js also loads these files for local PostgreSQL testing.

auditserver=
auditdb=
audituser=
auditpassword=

# If the audit DB shares credentials with the roster DB, `mssqlserver.js`
# will also fall back to `user` / `password` when `audituser` /
# `auditpassword` are blank.
server=
database=
rosteruser=
rosterpassword=
user=
password=

# Optional but recommended for links generated in backend emails.
APP_BASE_URL=

# Local server.js PostgreSQL settings.
PGHOST=localhost
PGDATABASE=audit_db
PGUSER=
PGPASSWORD=
PGPORT=5432

# Optional. mssqlserver.js defaults to production and server.js defaults to development.
NODE_ENV=
