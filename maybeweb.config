<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Proxy /api to the Express backend -->
        <rule name="NGAT API Root" stopProcessing="true">
          <match url="^api$" />
          <action type="Rewrite" url="http://10.44.6.67:3001/api" appendQueryString="true" />
        </rule>

        <rule name="NGAT API" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://10.44.6.67:3001/api/{R:1}" appendQueryString="true" />
        </rule>

        <!-- Everything else goes to the frontend preview server -->
        <rule name="NGAT Frontend" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="^/api(?:/.*)?$" negate="true" />
          </conditions>
          <action type="Rewrite" url="http://10.44.6.67:4173/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
